UMSCCP_Packet ::= SEQUENCE
{
    instance                                      [0] UTF8String,
    sccp_instance                                 [1] UTF8String,
    -- timestamps
    created                                       [3] UTF8String,
    afterFilter1                                  [4] UTF8String,
    reassembled                                   [5] UTF8String,
    afterFilter2                                  [6] UTF8String,
    routed                                        [7] UTF8String,
    afterFilter3                                  [8] UTF8String,
    segmented                                     [9] UTF8String,
    afterFilter4                                  [10] UTF8String,
    queuedForDelivery                             [11] UTF8String,
    
    state                                         [12] UTF8String,
    incomingSegment                               [13] UMSCCP_PacketSegment,
    
    incomingLocalUser                             [14] UTF8String,
    incomingMtp3Layer                             [15] UTF8String,
    incomingLinksetName                           [16] UTF8String,
    incomingOptions                               [17] NSDictionary,
    incomingOpc                                   [18] INTEGER,
    incomingDpc                                   [19] INTEGER,
    incomingServiceClass                          [20] INTEGER,
    incomingServiceType                           [21] INTEGER,
    incomingHandling                              [22] INTEGER,
    incomingMaxHopCount                           [23] INTEGER,
    incomingFromLocal                             [24] INTEGER,
    incomingToLocal                               [25] INTEGER,
    incomingCallingPartyAddressBeforeTranslation  [26] SCCPAddress,
    incomingCallingPartyAddress                   [27] UTF8String,
    incomingCallingPartyCountry                   [28] UTF8String,
    incomingCalledPartyAddressBeforeTranslation   [29] UTF8String,
    incomingCalledPartyAddress                    [30] UTF8String,
    incomingCalledPartyCountry                    [31] UTF8String,
    incomingMtp3Data                              [32] UTF8String,
    ncomingSccpData                               [33] UTF8String,
    incomingOptionalData                          [34] UTF8String,
    incomingReturnCause                           [35] UTF8String,
    outgoingLocalUser                             [36] UTF8String,
    outgoingMtp3Layer                             [37] UTF8String,
    outgoingLinksetName                           [38] UTF8String,
    outgoingOptions                               [39] UTF8String,
    outgoingOpc                                   [40] UTF8String,
    outgoingDpc                                   [41] UTF8String,
    outgoingServiceClass                          [42] UTF8String,
    outgoingServiceType                           [43] UTF8String,
    outgoingHandling                              [44] UTF8String,
    outgoingCallingPartyAddressBeforeTranslation  [45] UTF8String,
    outgoingCalledPartyAddressBeforeTranslation   [46] UTF8String,
    outgoingCallingPartyAddress                   [47] UTF8String,
    outgoingCalledPartyAddress                    [48] UTF8String,
    outgoingMtp3Data                              [49] UTF8String,
    outgoingSccpData                              [50] UTF8String,
    outgoingSegment                               [51] UTF8String,
    outgoingOptionalData                          [52] UTF8String,
    outgoingMaxHopCount                           [53] UTF8String,
    outgoingFromLocal                             [54] UTF8String,
    outgoingToLocal                               [55] UTF8String,
    outgoingReturnCause                           [56] UTF8String,
    outgoingDestination                           [57] UTF8String,
    incomingTcapAsn1                              [58] UTF8String,
    incomingTcapBegin                             [59] UTF8String,
    incomingTcapContinue                          [60] UTF8String,
    incomingTcapEnd                               [61] UTF8String,
    incomingTcapAbort                             [62] UTF8String,
    incomingTcapUnidirectional                    [63] UTF8String,
    incomingTcapCommand                           [64] UTF8String,
    incomingApplicationContext                    [65] UTF8String,
    incomingGsmMapAsn1                            [66] UTF8String,
    incomingGsmMapOperations                      [67] UTF8String,
    incomingCategory                              [68] UTF8String,
    canNotDecode                                  [71] UTF8String,
    tags                                          [72] UTF8String,
    vars                                          [73] UTF8String,
    rerouteDestinationGroup                       [74] UTF8String,
    logLevel                                      [75] UTF8String,
    incoming_tcap_otid                            [76] UTF8String,
    incoming_tcap_dtid                            [77] UTF8String,
    msisdn                                        [78] UTF8String,
    imsi                                          [79] UTF8String,
    smsc                                          [80] UTF8String,
    hlr                                           [81] UTF8String,
    msc                                           [82] UTF8String,
    sms                                           [83] UTF8String,
    partsInfo                                     [84] UTF8String,
    routingSelector                               [85] UTF8String,
    sls                                           [86] UTF8String,
    cga_number_translation_in                     [87] UTF8String,
    cda_number_translation_in                     [88] UTF8String,
    cga_number_translation_out                    [89] UTF8String,
    cda_number_translation_out                    [90] UTF8String,
    incomingLinksetInboundName                    [91] UTF8String,
     //   UMSCCP_Packet_Tag_outgoingLocalTransactionId                    [92] UTF8String,
     //   UMSCCP_Packet_Tag_outgoingRemoteTransactionId                   [93] UTF8String,
    
    
    
    }
