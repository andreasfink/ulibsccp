UMSCCP_Packet ::= SEQUENCE
{
    instanceName                                [1] UTF8String OPTIONAL,
    sccpInstanceName                            [2] UTF8String OPTIONAL,
    mtp3InstanceName                            [3] UTF8String OPTIONAL,
    created                                     [4] UTF8String OPTIONAL,
    linksetName                                 [5] UTF8String OPTIONAL,
    variant                                     [6] UTF8String OPTIONAL,
    networkIndicator                            [7] INTEGER,
    opc                                         [8] INTEGER,
    dpc                                         [9] INTEGER,
    serviceClass                                [10] UTF8String OPTIONAL,
    serviceType                                 [11] UTF8String OPTIONAL,
    handling                                    [12] UTF8String OPTIONAL,
    maxHopCount                                 [13] INTEGER,
    callingPartyAddressBeforeTranslation        [14] SccpAddress,
    callingPartyAddress                         [15] SccpAddress,
    callingPartyCountry                         [16] UTF8String OPTIONAL,
    callingPartyPrefix                          [17] UTF8String OPTIONAL,
    calledPartyAddressBeforeTranslation         [18] SccpAddress,
    calledPartyAddress                          [19] SccpAddress,
    calledPartyCountry                          [20] UTF8String OPTIONAL,
    calledPartyPrefix                           [21] UTF8String OPTIONAL,
    mtp3Data                                    [22] OCTET STRING,
    sccpData                                    [23] OCTET STRING,
    optionalData                                [24] OCTET STRING,
    returnCause                                 [25] UTF8String OPTIONAL,
    tcapType                                    [26] UTF8String OPTIONAL,
    applicationContext                          [27] UTF8String OPTIONAL,
    mapOperations                               [28] UTF8String OPTIONAL,
    tcap_oid                                    [29] UTF8String OPTIONAL,
    tcap_did                                    [30] UTF8String OPTIONAL,
    msisdn                                      [31] UTF8String OPTIONAL,
    imsi                                        [32] UTF8String OPTIONAL,
    smsc                                        [33] UTF8String OPTIONAL,
    hlr                                         [34] UTF8String OPTIONAL,
    msc                                         [35] UTF8String OPTIONAL,
    partsInfo                                   [36] UTF8String OPTIONAL,
    routingSelector                             [37] UTF8String OPTIONAL,
    error                                       [38] UTF8String OPTIONAL,
    dropped                                     [51] NULL OPTIONAL,
    fromLocal                                   [52] NULL OPTIONAL,
    toLocal                                     [53] NULL OPTIONAL,
    canNotDecode                                [54] NULL OPTIONAL,
    routingTest                                 [55] NULL OPTIONAL,
    isIncoming                                  [56] NULL OPTIONAL,
    custom0                                     [100] UTF8String OPTIONAL,
    custom1                                     [101] UTF8String OPTIONAL,
    custom2                                     [102] UTF8String OPTIONAL,
    custom3                                     [103] UTF8String OPTIONAL,
    custom4                                     [104] UTF8String OPTIONAL,
    custom5                                     [105] UTF8String OPTIONAL,
    custom6                                     [106] UTF8String OPTIONAL,
    custom7                                     [107] UTF8String OPTIONAL,
    custom8                                     [108] UTF8String OPTIONAL,
    custom9                                     [109] UTF8String OPTIONAL,
    data0                                       [110] OCTET STRING,
    data1                                       [111] OCTET STRING,
    data2                                       [112] OCTET STRING,
    data3                                       [113] OCTET STRING,
    data4                                       [114] OCTET STRING,
    data5                                       [115] OCTET STRING,
    data6                                       [116] OCTET STRING,
    data7                                       [117] OCTET STRING,
    data8                                       [118] OCTET STRING,
    data9                                       [119] OCTET STRING,
}
